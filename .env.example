# Copy to .env and adjust if the defaults clash with something already running locally.
# Docker Compose reads .env; the backend reads these same names from the environment and
# falls back to the values below, so an untouched setup needs no .env at all.
POSTGRES_DB=tuplakupla
POSTGRES_USER=tuplakupla
POSTGRES_PASSWORD=tuplakupla
POSTGRES_PORT=5432

# JWT signing key for the backend. The app falls back to a dev-only secret when unset;
# any real deployment must override this with a random 32+ byte value.
JWT_SECRET=dev-only-secret-key-please-change-me-3f8a1c9e7b2d4f6a
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGIN=http://localhost:5173
